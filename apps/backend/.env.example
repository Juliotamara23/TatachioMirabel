# Base de datos
DATABASE_URL="file:../mirabel.db"

# Clave secreta para JWT — REQUERIDA (sin valor por defecto; issue #45)
# El backend NO arranca si no está configurada. El valor de abajo es solo un
# ejemplo de placeholder: CAMBIALO por una clave larga y aleatoria.
JWT_SECRET="supersecretkey2024"

# ─── Primer administrador ───────────────────────────────────────────
# Se crea automáticamente al arrancar el backend si no existe ningún
# ADMINISTRATOR. El registro de nuevos usuarios requiere ser admin.
ADMIN_EMAIL="admin@tatachio.com"
ADMIN_PASSWORD="cambia-esta-password"
ADMIN_NOMBRE="Administrador"

# ─── Proveedor de IA activo ───────────────────────────────────────
#
# Determina qué proveedor se usa por defecto para cada rol.
# Solo se necesita configurar UNO. Si configurás varios, AI_PROVIDER
# elige cuál se prefiere para los defaults de rol.
#
#   google     → Gemini (requiere GOOGLE_GENERATIVE_AI_API_KEY)
#   ollama     → modelos locales (requiere OLLAMA_BASE_URL)
#   openai     → GPT (requiere OPENAI_API_KEY)
#   anthropic  → Claude (requiere ANTHROPIC_API_KEY)
#   openrouter → OpenRouter (requiere OPENROUTER_API_KEY)
#
# Los proveedores declarados por config (ver abajo) también se pueden
# preferir con AI_PROVIDER si su clave está seteada.
#
AI_PROVIDER="google"

# ─── Google Gemini ────────────────────────────────────────────────
GOOGLE_GENERATIVE_AI_API_KEY=""

# ─── Ollama (local) ───────────────────────────────────────────────
# Descomentá para usar modelos locales sin API key ni rate limit.
# OLLAMA_BASE_URL apunta al endpoint compatible con OpenAI de Ollama
# (sin clave: @ai-sdk/openai se configura con apiKey vacío).
# OLLAMA_BASE_URL="http://localhost:11434/v1"

# ─── OpenAI ───────────────────────────────────────────────────────
# OPENAI_API_KEY=""

# ─── Anthropic ────────────────────────────────────────────────────
# ANTHROPIC_API_KEY=""

# ─── OpenRouter ───────────────────────────────────────────────────
# Envía los headers HTTP-Referer y X-Title con cada request (requisito
# de OpenRouter para uso público del endpoint).
# OPENROUTER_API_KEY=""

# ─── Vercel AI Gateway (failover, PR-3) ───────────────────────────
# Cuando está seteada, TODO el tráfico de producción pasa por el Vercel
# AI Gateway: failover HTTP vía order+models (Gemini → DeepSeek → Llama,
# ids curados del catálogo GatewayModelId, ante 5xx/429). Los errores a
# nivel de app (400) siguen llegando al cliente.
# Sin clave = acceso directo a los proveedores (dev/QA, R3.5).
AI_GATEWAY_API_KEY=""

# ─── Proveedores declarados por configuración (zero-code, R2.0) ────
# Agregá cualquier proveedor compatible con OpenAI (NVIDIA NIM,
# DeepSeek, Qwen, Moonshot, Groq, Together, etc.) SOLO con config,
# sin tocar código. Dos opciones:
#   1. Copiá config/providers.example.json → config/providers.json y
#      completá apiKeyEnv / baseURL / models (recomendado para varios).
#   2. Definí EXTRA_PROVIDERS_JSON con el JSON inline (gana sobre el
#      archivo si ambos están presentes).
# En ambos casos los modelos solo aparecen si su apiKeyEnv está seteada.
# PROVIDERS_CONFIG_PATH="config/providers.json"
# EXTRA_PROVIDERS_JSON=""

# ─── Tests de integración ─────────────────────────────────────────
#
# Modelo a usar en tests que llaman a la IA real.
# Cualquier ID del MODEL_REGISTRY funciona (auditados 2026-08-13):
#
#   google/gemini-3.1-flash-lite-preview  → verificado, rate limit 15/min
#   google/gemini-2.0-flash               → verificado, rate limit 15/min
#   ollama/qwen3.5:9b                     → verificado (catálogo Ollama)
#   ollama/llama3.2:3b                    → local, más rápido
#   ollama/mistral:7b                     → local, balanceado
#   openai/gpt-4.1-mini                   → verificado (catálogo OpenAI)
#   anthropic/claude-sonnet-4.5           → verificado (catálogo Anthropic)
#   openrouter/anthropic/claude-sonnet-4.5 → verificado (catálogo OpenRouter)
#
# Si no se configura, los tests de IA real se skipean.
TEST_AI_MODEL=""

# Saltar tests que requieren IA real (true = no corren)
SKIP_AI_TESTS="false"
