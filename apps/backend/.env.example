# Base de datos
DATABASE_URL="file:../mirabel.db"

# Clave secreta para JWT
JWT_SECRET="supersecretkey2024"

# ─── Proveedor de IA activo ───────────────────────────────────────
#
# Determina qué proveedor se usa por defecto para cada rol.
# Solo se necesita configurar UNO. Si configurás varios, AI_PROVIDER
# elige cuál se prefiere para los defaults de rol.
#
#   google    → Gemini (requiere GOOGLE_GENERATIVE_AI_API_KEY)
#   ollama    → modelos locales (requiere OLLAMA_BASE_URL)
#   openai    → GPT (requiere OPENAI_API_KEY + instalar @ai-sdk/openai)
#   anthropic → Claude (requiere ANTHROPIC_API_KEY + instalar @ai-sdk/anthropic)
#
AI_PROVIDER="google"

# ─── Google Gemini ────────────────────────────────────────────────
GOOGLE_GENERATIVE_AI_API_KEY=""

# ─── Ollama (local) ───────────────────────────────────────────────
# Descomentá para usar modelos locales sin API key ni rate limit.
# OLLAMA_BASE_URL="http://localhost:11434/api"

# ─── OpenAI (requiere: pnpm add @ai-sdk/openai) ───────────────────
# OPENAI_API_KEY=""

# ─── Anthropic (requiere: pnpm add @ai-sdk/anthropic) ─────────────
# ANTHROPIC_API_KEY=""

# ─── Tests de integración ─────────────────────────────────────────
#
# Modelo a usar en tests que llaman a la IA real.
# Cualquier ID del MODEL_REGISTRY funciona:
#
#   google/gemini-3.1-flash-lite-preview  → más barato, rate limit 15/min
#   google/gemini-2.0-flash               → más capaz, rate limit 15/min
#   ollama/qwen3.5:9b                     → local, sin rate limit
#   ollama/llama3.2:3b                    → local, más rápido
#   ollama/mistral:7b                     → local, balanceado
#
# Si no se configura, los tests de IA real se skipean.
TEST_AI_MODEL=""

# Saltar tests que requieren IA real (true = no corren)
SKIP_AI_TESTS="false"
