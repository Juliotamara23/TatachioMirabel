# Base de datos
DATABASE_URL="file:../mirabel.db"

# Clave secreta para JWT
JWT_SECRET="supersecretkey2024"

# ─── Configuración de IA ──────────────────────────────────────────

# Proveedor por defecto: google | ollama
AI_PROVIDER="google"

# Google Gemini API Key (requerida si AI_PROVIDER=google)
GOOGLE_GENERATIVE_AI_API_KEY=""

# Ollama (requerido si AI_PROVIDER=ollama)
OLLAMA_BASE_URL="http://localhost:11434/api"

# ─── Tests de integración ─────────────────────────────────────────

# Modelo a usar en tests de integración que llaman a la IA real.
# Elegí uno según lo que tengas disponible:
#
#   google/gemini-3.1-flash-lite-preview  → más barato, rápido, rate limit 15/min
#   google/gemini-2.0-flash               → más capaz, rate limit 15/min
#   ollama/qwen3.5:9b                     → local, sin rate limit, sin costo
#   ollama/llama3.2:3b                    → local, más rápido, sin costo
#
# Si no se configura, los tests de IA real se skipean.
TEST_AI_MODEL=""

# Saltar tests que requieren IA real (true = no corren)
# Útil en CI donde no hay API key ni Ollama disponible.
SKIP_AI_TESTS="false"
