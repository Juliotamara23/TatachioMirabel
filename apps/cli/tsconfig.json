{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "./build/",
    "rootDir": "./src/",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@tatachio/shared": ["../shared/src/index.ts"],
      "@tatachio/shared/*": ["../shared/src/*"]
    }
  },
  "include": ["src/**/*"]
}