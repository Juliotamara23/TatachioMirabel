#!/bin/sh
# Pre-push QA cleanup rule (issue #62).
# The QA is disposable: test → report → destroy. Before pushing, remove every
# artifact the QA may have created so nothing generated by tests/suites leaks
# into the repository or the environment.
#
# Activation (one-time per clone):
#   git config core.hooksPath .githooks

if [ -f scripts/qa/cleanup.mjs ]; then
  echo "[pre-push] QA cleanup (disposable artifacts)..."
  node scripts/qa/cleanup.mjs
fi

exit 0
